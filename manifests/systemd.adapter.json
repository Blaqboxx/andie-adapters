{
  "schema_version": "1.0",
  "adapter_id": "systemd",
  "display_name": "systemd Adapter",
  "version": "1.0.0",
  "audited": true,
  "execution": {
    "dry_run_supported": true,
    "rollback": {
      "feasible": true,
      "strategies": [
        "restart_previous_unit_state",
        "revert_daemon_configuration"
      ]
    }
  },
  "capabilities": [
    {
      "id": "systemd.unit.status",
      "operation": "inspect unit status",
      "scope": "observe",
      "risk_tier": "low",
      "dangerous": false,
      "production_default": "allow",
      "requires_approval": false,
      "audit_classification": "read"
    },
    {
      "id": "systemd.unit.restart",
      "operation": "restart unit",
      "scope": "restart",
      "risk_tier": "high",
      "dangerous": true,
      "production_default": "supervised",
      "requires_approval": true,
      "audit_classification": "sensitive_change"
    },
    {
      "id": "systemd.daemon.reload",
      "operation": "reload systemd daemon",
      "scope": "configure",
      "risk_tier": "high",
      "dangerous": true,
      "production_default": "supervised",
      "requires_approval": true,
      "audit_classification": "sensitive_change"
    }
  ],
  "blast_radius": {
    "scope": "host",
    "reversible": true,
    "max_affected_units": 20
  },
  "telemetry_requirements": [
    {
      "signal": "unit_active_state",
      "source": "systemd_dbus",
      "required_for_verify": true,
      "stabilization_window_seconds": 120
    },
    {
      "signal": "unit_failure_rate",
      "source": "host_metrics",
      "required_for_verify": false,
      "stabilization_window_seconds": 300
    }
  ],
  "governance": {
    "policy_profiles_supported": [
      "dev",
      "staging",
      "prod"
    ],
    "least_privilege": true,
    "deny_by_default_dangerous": true
  }
}
